# Variables de entorno para Python Master Game
# Para conectar a Supabase o PostgreSQL en la nube (Render / Supabase):
# Copia este archivo a .env y completa los valores.

# Ejemplo con Supabase (Transaction Pooler o Direct Connection):
# DATABASE_URL="postgresql://postgres:[TU_PASSWORD_AQUI]@db.[TU_PROJECT_REF].supabase.co:5432/postgres"

# O usa SUPABASE_DB_URL:
# SUPABASE_DB_URL="postgresql://postgres:[TU_PASSWORD_AQUI]@db.[TU_PROJECT_REF].supabase.co:5432/postgres"

# Puerto en local (en Render se asigna automáticamente por $PORT):
PORT=8000
